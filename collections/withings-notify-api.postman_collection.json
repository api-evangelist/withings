        {
          "id": "8bbe4294-2cda-442c-be47-09f493e8e83a",
          "name": "Notify  - Subscribe",
          "request": {
            "name": "Notify  - Subscribe",
            "description": {
              "content": "This service allows to receive notifications from Withings:\n\n- for the Health Data APIs : your application can subscribe to a variety or events, including user data  creation and updates. Notifications will be sent to your servers when the subscribed events occur. ([more information](/developer-guide/v3/data-api/notifications/notification-overview)). Please note that you need to subscribe for each individual user.\n- for the Logistics APIs: a notification will be sent when there is an order update ([more information](developer-guide/v3/integration-guide/dropship-only/logistics-api/observe-order-updates))\n- for partners integrating Withings Cellular Solutions or Withings Mobile SDK: you can use the ```NO_ACCOUNT_ASSOCIATED``` event to track unassociated devices . Please note you need to subscribe only once per application.\n\n**Note**: depending on your use case, the request parameters may change:\n\n- for the Health Data APIs: use a valid ```access_token``` in the header but don't use ```signature``` and ```nonce``` in the query parameters.\n- for the Logistics APIs: the subscription is done automatically an order is placed (please refer to the [dedicated documentation section](developer-guide/v3/integration-guide/dropship-only/logistics-api/observe-order-updates#how-to-receive-order-update-notifications))\n- for partners integrating Withings Cellular Solutions or Withings Mobile SDK, to subscribe to the ```NO_ACCOUNT_ASSOCIATED``` event (appli = 53): use ```signature``` and ```nonce``` parameters but don't include an ```access_token``` in the header.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{baseUrl}}/https",
              "path": [
                "notify"
              ],
              "host": [
                "wbsapi",
                "withings",
                "net"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) Service action name. Must take the string value ```subscribe```."
                },
                {
                  "disabled": false,
                  "key": "callbackurl",
                  "value": "<string>",
                  "description": "(Required) Your ```Callback URL```."
                },
                {
                  "disabled": false,
                  "key": "appli",
                  "value": "<integer>",
                  "description": "(Required) Refer to the [Notifications section](/developer-guide/v3/data-api/notifications/notification-overview/) to know which value you should use."
                },
                {
                  "disabled": false,
                  "key": "signature",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token]<br>Hash of params (Cf. [Signature hash protocol](/developer-guide/v3/get-access/sign-your-requests))."
                },
                {
                  "disabled": false,
                  "key": "nonce",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token]<br>A random token used to prevent replay attacks (Cf. [Signature v2 - Getnonce](#operation/signaturev2-getnonce))"
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token]<br>Id of the client"
                },
                {
                  "disabled": false,
                  "key": "comment",
                  "value": "<string>",
                  "description": "Comment."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
