        {
          "id": "669f00e3-bf6a-4bf3-b1cd-d60c00709dfe",
          "name": "User v2  - Activate",
          "request": {
            "name": "User v2  - Activate",
            "description": {
              "content": "Creates a Withings user, links the devices related to the provided ```mac_addresses``` and activates the cellular devices service and invoicing.\n\nPlease refer to the [Access and refresh tokens section](/developer-guide/v3/integration-guide/bulkship-cellular/get-access/access-and-refresh-tokens) to learn how to use the authorization code you'll get in return of this service in order to fetch user data. The authorization code is only valid for *10 minutes*.\n\n**Important**:\n\n- Please note that to activate the Withings HUB cellular service, the ```mac_address``` of the Withings HUB needs to be passed included in the input mac_addresses along with the other Withings devices.\n- Please note that the devices need to be authorized to be linked by API by the Partner. Please [contact Withings](mailto:partner-api@withings.com) for more information on device authorization.\n\n*This service is part of Withings Pro Solutions. You won't be able to use it if you did not sign a contract with Withings.*\n*Use this service only if you're integrating Withings Cellular Solutions with bulkshipment.*",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{baseUrl}}/https",
              "path": [
                "v2",
                "user "
              ],
              "host": [
                "wbsapi",
                "withings",
                "net"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) Service action name. Must take the string value ```activate```."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Id of the client"
                },
                {
                  "disabled": false,
                  "key": "nonce",
                  "value": "<string>",
                  "description": "(Required) A random token used to prevent replay attacks (Cf. [Signature v2 - Getnonce](#operation/signaturev2-getnonce))"
                },
                {
                  "disabled": false,
                  "key": "signature",
                  "value": "<string>",
                  "description": "(Required) Hash of params (Cf. [Signature hash protocol](/developer-guide/v3/get-access/sign-your-requests))."
                },
                {
                  "disabled": false,
                  "key": "mailingpref",
                  "value": "<boolean>",
                  "description": "(Required) Specifies if customer accepted Withings commercial contacts."
                },
                {
                  "disabled": false,
                  "key": "birthdate",
                  "value": "<integer>",
                  "description": "(Required) Unix timestamp of user's birthdate"
                },
                {
                  "disabled": false,
                  "key": "measures",
                  "value": "<json_string>",
                  "description": "(Required) User measures (Cf. [Measures](#tag/models/Measures) model)."
                },
                {
                  "disabled": false,
                  "key": "gender",
                  "value": "<integer>",
                  "description": "(Required) 0: man, 1: woman"
                },
                {
                  "disabled": false,
                  "key": "preflang",
                  "value": "<string>",
                  "description": "(Required) User language preference. Examples: en_EN / en_US / de_DE / es_ES / fr_FR / it_IT / ja_JA / ko_KR / nl_NL / pt_PT / ru_RU / zh_CN"
                },
                {
                  "disabled": false,
                  "key": "unit_pref",
                  "value": "<json>",
                  "description": "(Required) Unit pref (cf. [Unit preferences](#tag/models/Unit-preferences) model)."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "(Required) User's email address"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<timezone>",
                  "description": "(Required) User's timezone. Examples: \"Europe/Paris\" / \"America/New_York\". A complete list of all possible timezones can be found on the \"TZ database name\" column of this page : https://en.wikipedia.org/wiki/List_of_tz_database_time_zones"
                },
                {
                  "disabled": false,
                  "key": "shortname",
                  "value": "<string>",
                  "description": "(Required) 3 characters representing the end user (ex: for a user named Robert, you could set the shortname param to ROB). These characters will be displayed on device screens when used.<br>Shortname must respect the following regex: /^[a-zA-Z0-9]{3}$/ (either letters or numbers, special characters and spaces are not allowed)."
                },
                {
                  "disabled": false,
                  "key": "external_id",
                  "value": "<string>",
                  "description": "(Required) Unique identifier used by the partner to identify the end-user."
                },
                {
                  "disabled": false,
                  "key": "mac_addresses",
                  "value": "<macaddress>",
                  "description": "(Required) List of Withings device MAC addresses that will be linked to the created user. Example: [\"00:24:e4:xx:xx:xx\",\"00:24:e4:xx:xx:xx\"]"
                },
                {
                  "disabled": false,
                  "key": "firstname",
                  "value": "<string>",
                  "description": "User's firstname (if not set, will take the same value as shortname)"
                },
                {
                  "disabled": false,
                  "key": "lastname",
                  "value": "<string>",
                  "description": "User's lastname (if not set, will take the same value as shortname)"
                },
                {
                  "disabled": false,
                  "key": "phonenumber",
                  "value": "<string>",
                  "description": "Phone number in E.164 format. End user will receive a verification code on this phone number for 2 factor authentication if they wish to securely access the data of their program in the withings app in the future (recommended)"
                },
                {
                  "disabled": false,
                  "key": "recovery_code",
                  "value": "<string>",
                  "description": "Recovery code can be used by end user as a 2nd authentication factor in the withings app if they wish to securely access the data of their program in the future.  You will be responsible of securely providing this recovery code to your user if he asks for it."
                },
                {
                  "disabled": false,
                  "key": "goals",
                  "value": "<json>",
                  "description": "Goals (cf. [Goals](#tag/models/Goals) model)."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<partner_redirect_uri>",
                  "description": "\nThe URI we should redirect the user to after choosing to authorize or not your app. This URI must be set as ```Callback Url``` in your partner application. It is possible to use multiple URLs by separating them with a comma.\n\nExamples:\n\n- Callbacks: https://mydomain.com/\n- Callback: https://mydomain.com/,https://mydomain2.com/\n- Valid URL: https://mydomain.com/relative_path?args=value"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
