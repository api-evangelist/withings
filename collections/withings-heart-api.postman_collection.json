  "item": [
    {
      "id": "39632509-ea81-4c7c-94e0-dada63c9fd2f",
      "name": "heart",
      "description": {
        "content": "Returns ECG (EKG) signal points in micro-volt (μV).\n\nYou can use the [Heart - List](#operation/heartv2-list) service to get the list of ECG records and their corresponding ```signalid``` and then use [Heart - Get](#operation/heartv2-get) to get the signal details.\n\nThe data are only available once a synchronization occured between the device and Withings servers (which might include synchronizing with Withings mobile application or via Withings Mobile SDK).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "658473c0-7f0a-4c3a-a24d-577dbb27b16e",
          "name": "Heart v2  - Get",
          "request": {
            "name": "Heart v2  - Get",
            "description": {
              "content": "Provides the high frequency data of an ECG recording in micro-volt (μV).\n\n**Duration:**\n\n - BPM Core: 20 seconds.\n - Move ECG: 30 seconds.\n - ScanWatch: 30 seconds.\n\n**Sampling frequency:**\n\n - BPM Core: 500 Hz.\n - Move ECG: 300 Hz.\n - ScanWatch: 300 Hz.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{baseUrl}}/https",
              "path": [
                "v2",
                "heart "
              ],
              "host": [
                "wbsapi",
                "withings",
                "net"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) Service action name. Must take the string value ```get```."
                },
                {
                  "disabled": false,
                  "key": "signalid",
                  "value": "<id32m64>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [client_id, signature, nonce, signal_token]<br>ID of a signal"
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token, signalid]<br>Id of the client"
                },
                {
                  "disabled": false,
                  "key": "signature",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token, signalid]<br>Hash of params (Cf. [Signature hash protocol](/developer-guide/v3/get-access/sign-your-requests))."
                },
                {
                  "disabled": false,
                  "key": "nonce",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token, signalid]<br>A random token used to prevent replay attacks (Cf. [Signature v2 - Getnonce](#operation/signaturev2-getnonce))"
                },
                {
                  "disabled": false,
                  "key": "signal_token",
                  "value": "<string>",
                  "description": "(Required) DO NOT USE WITH FOLLOWING PARAMS: [access_token, signalid]<br>Signal identifier"
                },
                {
                  "disabled": false,
                  "key": "with_filtered",
                  "value": "<boolean>",
                  "description": "Request filtered version of the signal"
                },
                {
                  "disabled": false,
                  "key": "with_intervals",
                  "value": "<boolean>",
                  "description": "Request features with inactive ones"
                }
