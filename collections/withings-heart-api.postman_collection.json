          "name": "Heart v2  - List",
          "request": {
            "name": "Heart v2  - List",
            "description": {
              "content": "Returns a list of ECG records and Afib classification for a given period of time.\nTo get the full ECG signal, use the [Heart v2 - Get](#operation/heartv2-get) service.\n\nIf the ECG recordings have been taken with BPM Core, systole and diastole measurements will also be returned.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{baseUrl}}/https",
