          "name": "Rawdata v2  - Get",
          "request": {
            "name": "Rawdata v2  - Get",
            "description": {
              "content": "This service allows to fetch raw data of a specific type that were captured and synchronized by a Withings device. Detailled information about the data structure can be found in the [Raw Data structure section](/developer-guide/v3/integration-guide/public-health-data-api/data-api/raw-data).",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{baseUrl}}/https",
              "path": [
                "v2",
                "rawdata"
              ],
              "host": [
                "wbsapi",
                "withings",
                "net"
              ],
