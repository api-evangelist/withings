  "item": [
    {
      "id": "7e2e28f9-3106-4d5b-bdfd-86ec5226c311",
      "name": "rawdata",
      "description": {
        "content": "Raw Data webservices are part of the Advanced research API that allows to collect high frequency PPG and accelerometer data (around 25Hz). These APIs are compatible only with the Withings ScanWatch. If you need more information about how to use these APIs and how to parse the data, please have a look the [dedicated integration guide](/developer-guide/v3/integration-guide/public-health-data-api/data-api/raw-data).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0b48e3d3-c7b0-40b9-af32-e0e8bb391d01",
          "name": "Rawdata v2  - Activate",
          "request": {
            "name": "Rawdata v2  - Activate",
            "description": {
              "content": "This service allows to activate Raw Data collection on a given device that is already set up, and set the date at which the raw data collection will stop (enddate). The raw data capture will be activated as soon as the watch is able to sync with the Withings app following the API call. The capture will stop automatically at the enddate provided in the API call.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{baseUrl}}/https",
              "path": [
                "v2",
                "rawdata "
              ],
              "host": [
                "wbsapi",
                "withings",
                "net"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) Service action name. Must take the string value ```activate```."
                },
                {
                  "disabled": false,
                  "key": "hash_deviceid",
                  "value": "<string>",
                  "description": "(Required) Public device id. For any device installed on a user account, can be found by calling the User v2 - Get webservice."
                },
                {
                  "disabled": false,
                  "key": "rawdata_type",
                  "value": "<integer>",
                  "description": "(Required) The type of raw data you want to act upon. Set to 1 for accelerometer, set to 2 for optical sensor."
                },
                {
                  "disabled": false,
                  "key": "enddate",
                  "value": "<integer>",
                  "description": "Data end date as a unix timestamp."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
